<idea-plugin>
    <id>com.kanicream.repolens</id>
    <name>Repo Lens</name>
    <vendor>kani-cream</vendor>

    <description><![CDATA[
        <p>Repo Lens is a code review navigator. It collects review candidates
        (large files, TODO / FIXME markers, and more to come) into a single tool window,
        lets you jump from a finding straight to the code, and copies selected findings
        as structured Markdown that you can paste into any AI chat or review tool.</p>

        <p>Repo Lens never calls an AI API, stores no API keys, requires no external
        server, and never sends your source code anywhere. The clipboard is written only
        on an explicit Copy action.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Local Changes scope. Present in every JetBrains IDE; a project without a
         configured VCS is handled at runtime, not by disabling the plugin. -->
    <depends>com.intellij.modules.vcs</depends>

    <!-- Structure analysis needs UAST, which ships inside the Java plugin. Optional so
         Repo Lens Core still loads in IDEs without Java. -->
    <depends optional="true" config-file="repo-lens-uast.xml">com.intellij.modules.java</depends>

    <extensionPoints>
        <extensionPoint name="codeStructureProvider" interface="com.kanicream.repolens.structure.CodeStructureProvider"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Repo Lens"
                    anchor="bottom"
                    icon="/icons/repoLens.svg"
                    factoryClass="com.kanicream.repolens.ui.RepoLensToolWindowFactory"/>
        <projectConfigurable parentId="tools"
                             id="com.kanicream.repolens.settings"
                             displayName="Repo Lens"
                             instance="com.kanicream.repolens.settings.RepoLensConfigurable"/>
    </extensions>

    <actions>
        <action id="com.kanicream.repolens.AnalyzeSelection"
                class="com.kanicream.repolens.action.AnalyzeSelectionAction"
                text="Analyze with Repo Lens"
                description="Collect Repo Lens review candidates for the selected files">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
